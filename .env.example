# Cloudflare account used for `wrangler pages deploy`.
# Copy to .env and fill in. Overrides the global `wrangler login` OAuth token.
# Token needs: Account > Cloudflare Pages > Edit, and User > User Details > Read.
CLOUDFLARE_API_TOKEN=
# Required when the token can see more than one account, otherwise wrangler
# prompts interactively and spawnSync in lib/cloudflare.mjs hangs.
CLOUDFLARE_ACCOUNT_ID=
